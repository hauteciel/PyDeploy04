# 이 파일을 복사해 .env 로 저장한 뒤 실제 값으로 채우세요. (.env는 git에 커밋되지 않습니다)

# development | production
ENVIRONMENT=development

# --- Database (dev: 로컬 MySQL, prod: RDS 엔드포인트) ---
DB_USER=myuser
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mydb

# --- CORS: 콤마(,)로 구분된 프론트엔드 허용 주소 ---
# dev 예: http://localhost:5173,http://127.0.0.1:5173
# prod 예: https://www.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File storage: local(dev) | s3(prod) ---
STORAGE_BACKEND=local
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
